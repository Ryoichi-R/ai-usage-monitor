{
  "schema_version": "1.0",
  "public_root": ".",
  "profiles": ["source-repository"],
  "documents": [
    {
      "path": "README.md",
      "required_sections": ["概要", "ライセンス"]
    },
    {
      "path": "SECURITY.md",
      "required_sections": []
    },
    {
      "path": "LICENSE",
      "required_sections": []
    },
    {
      "path": "CONTRIBUTING.md",
      "required_sections": []
    }
  ],
  "candidate": {
    "allowlist": ["**"],
    "denylist": [
      "project/.work/**",
      "project/artifacts/**",
      "project/bin/**",
      "project/**/bin/**",
      "project/obj/**",
      "project/**/obj/**",
      "project/TestResults/**",
      "project/**/TestResults/**",
      "project/coverage/**",
      "project/**/coverage/**",
      ".codex/**",
      "facade-contract-*/**",
      "**/*.tmp",
      "**/*.log"
    ],
    "max_file_bytes": 2097152,
    "max_total_bytes": 10485760,
    "allow_reparse_points": false
  },
  "validation": {
    "required_receipt_types": ["quality", "manual-acceptance", "clean-verification"],
    "expected_test_projects": [
      "AiUsageMonitor.App.Tests",
      "AiUsageMonitor.Claude.Tests",
      "AiUsageMonitor.Claude.Windows.Tests",
      "AiUsageMonitor.Codex.Tests",
      "AiUsageMonitor.Core.Tests",
      "AiUsageMonitor.Windows.Tests"
    ],
    "minimum_test_count": 460,
    "allow_skips": false,
    "minimum_line_coverage": 90,
    "minimum_branch_coverage": null,
    "require_formatter": true,
    "require_linter": false,
    "require_dependency_review": true
  },
  "manual_acceptance": [
    {
      "id": "windows-x64",
      "requirement": "required",
      "reason": "Portable配布物はWindows x64実機での起動・表示・終了確認を必須とする。"
    },
    {
      "id": "live-codex",
      "requirement": "required",
      "reason": "Codex利用量取得はfake CLIだけでなく、live Codex CLIとの実接続確認を必須とする。"
    },
    {
      "id": "live-claude",
      "requirement": "required",
      "reason": "Claude利用量取得はfake CLIだけでなく、live Claude CLIとの実接続確認を必須とする。"
    },
    {
      "id": "arm64-runtime",
      "requirement": "conditional",
      "reason": "ARM64実機検証は本安定化プランの対象外。ARM64 candidateを公開する場合だけ実機確認を追加する。"
    }
  ],
  "artifacts": [],
  "integrity": {
    "require_hashes": true,
    "require_sbom": false,
    "require_dependency_review": true,
    "require_clean_install": true
  }
}
