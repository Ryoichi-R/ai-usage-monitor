<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <UseAppHost>true</UseAppHost>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <!--
    Claude CLI本体だけを模擬する。console helper protocol（AttachConsole等のWindows専用API）は
    AiUsageMonitor.FakeClaudeConsoleHelperHost が担当するため、ここからproduction assemblyを
    参照せず、macOSでもrestore・実行できるportableなsupportに保つ。
  -->
</Project>
