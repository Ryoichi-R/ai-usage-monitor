<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseAppHost>true</UseAppHost>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <!--
    ConsoleHelperClientが起動する「helper host」役をテストで再現する。
    ClaudeConsoleHelper（AttachConsole / ReadConsoleOutputCharacterW）はWindows専用のため、
    このプロジェクトだけがnet10.0-windowsに留まる。CLI本体の模擬はportableな
    AiUsageMonitor.FakeClaudeCli が担当し、両者を混ぜない。
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\AiUsageMonitor.Claude.Windows\AiUsageMonitor.Claude.Windows.csproj" />
  </ItemGroup>
</Project>
