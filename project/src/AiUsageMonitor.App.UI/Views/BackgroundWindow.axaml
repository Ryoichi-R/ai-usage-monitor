<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AiUsageMonitor.App.UI.Views.BackgroundWindow"
        Title="AI Usage Monitor Background"
        Width="280"
        Height="220"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        CanResize="False"
        Topmost="False"
        UseLayoutRounding="True">
  <Border x:Name="BackgroundFadeHost" IsHitTestVisible="False">
    <Border x:Name="BackgroundRoot" Background="Transparent" IsHitTestVisible="False"/>
  </Border>
</Window>
