<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AiUsageMonitor.App.UI.Views.WelcomeWindow"
        Title="AI Usage Monitorへようこそ"
        Width="560"
        Height="360"
        MinWidth="520"
        MinHeight="330"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ShowInTaskbar="False">
  <Grid Margin="24" RowDefinitions="Auto,*,Auto">
    <StackPanel>
      <TextBlock Text="AI Usage Monitorへようこそ"
                 FontSize="22"
                 FontWeight="SemiBold"/>
      <TextBlock x:Name="IntroText"
                 Text="最初に、表示するサービスを選んでください。後から通知領域の「設定…」で変更できます。"
                 Margin="0,10,0,0"
                 Foreground="Gray"
                 TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel Grid.Row="1" VerticalAlignment="Center">
      <Border BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
        <StackPanel>
          <TextBlock Text="Codexだけを使用する" FontWeight="SemiBold"/>
          <TextBlock Text="すぐに監視を開始します。Claude Codeは後から追加できます。"
                     Margin="0,4,0,0"
                     Foreground="Gray"
                     TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <Border BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="6" Padding="14">
        <StackPanel>
          <TextBlock Text="CodexとClaude Codeを使用する" FontWeight="SemiBold"/>
          <TextBlock Text="続けてClaude Code CLI連携ウィザードを開きます。設定ファイルは自動変更しません。"
                     Margin="0,4,0,0"
                     Foreground="Gray"
                     TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </StackPanel>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button x:Name="CodexOnlyButton"
              Content="Codexだけで開始"
              MinWidth="130"
              Padding="12,6"
              Margin="0,0,8,0"
              IsCancel="True"
              Click="OnCodexOnlyClick"/>
      <Button x:Name="ClaudeButton"
              Content="Claude Codeも設定"
              MinWidth="150"
              Padding="12,6"
              IsDefault="True"
              Click="OnClaudeClick"/>
    </StackPanel>
  </Grid>
</Window>
