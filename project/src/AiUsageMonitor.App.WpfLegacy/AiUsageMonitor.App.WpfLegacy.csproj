<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Phase 2の並存期間中の旧WPF版。配布中の実行ファイル名（AiUsageMonitor.App.exe）、
         自動起動登録、実行中検知、pack URIとの互換のため、Avalonia版App.Windowsが配布対象へ
         切り替わるまでassembly名と名前空間を改称前の値に固定する。 -->
    <AssemblyName>AiUsageMonitor.App</AssemblyName>
    <RootNamespace>AiUsageMonitor.App</RootNamespace>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\ai-usage-monitor.ico</ApplicationIcon>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(PublishSingleFile)' == 'true'">true</IncludeNativeLibrariesForSelfExtract>
    <Platforms>AnyCPU;x64;ARM64</Platforms>
    <UseAppHost Condition="'$(SelfContained)' != 'true'">false</UseAppHost>
    <NoWarn>$(NoWarn);CA1416;WFO0003</NoWarn>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AiUsageMonitor.Core\AiUsageMonitor.Core.csproj" />
    <ProjectReference Include="..\AiUsageMonitor.Codex\AiUsageMonitor.Codex.csproj" />
    <ProjectReference Include="..\AiUsageMonitor.Claude\AiUsageMonitor.Claude.csproj" />
    <ProjectReference Include="..\AiUsageMonitor.Claude.Cli\AiUsageMonitor.Claude.Cli.csproj" />
    <ProjectReference Include="..\AiUsageMonitor.Claude.Windows\AiUsageMonitor.Claude.Windows.csproj" />
    <ProjectReference Include="..\AiUsageMonitor.Platform\AiUsageMonitor.Platform.csproj" />
    <ProjectReference Include="..\AiUsageMonitor.Platform.Windows\AiUsageMonitor.Platform.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AiUsageMonitor.App.WpfLegacy.Tests" />
    <InternalsVisibleTo Include="AiUsageMonitor.App.WpfLegacy.Startup.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\ai-usage-monitor.ico" />
    <Content Include="Assets\claude-statusline-bridge.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <TargetPath>claude-statusline-bridge.ps1</TargetPath>
    </Content>
    <Content Include="..\..\README.md">
      <Link>README.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <TargetPath>README.md</TargetPath>
    </Content>
  </ItemGroup>
</Project>
