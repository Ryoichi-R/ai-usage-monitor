<Window x:Class="AiUsageMonitor.App.BackgroundWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Usage Monitor Background"
        Width="280" Height="220"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Opacity="1" ShowInTaskbar="False" ShowActivated="False"
        Focusable="False" ResizeMode="NoResize" Topmost="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Border x:Name="BackgroundFadeHost" IsHitTestVisible="False">
    <Border x:Name="BackgroundRoot" Background="Transparent" IsHitTestVisible="False" />
  </Border>
</Window>
