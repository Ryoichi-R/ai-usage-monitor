<Window x:Class="AiUsageMonitor.App.ClaudeSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Code連携"
        Icon="Assets/ai-usage-monitor.ico"
        Width="680"
        Height="680"
        MinWidth="620"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Bottom"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,16,0,0">
      <Button x:Name="CloseButton"
              Content="閉じる"
              MinWidth="96"
              Padding="12,6"
              IsDefault="True"
              IsCancel="True" />
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="Claude Code 自動取得の初期設定"
                   FontSize="22"
                   FontWeight="SemiBold" />
        <TextBlock Text="監視アプリ専用フォルダーをClaude Codeで1度だけ信頼してください。監視アプリは信頼確認を自動操作せず、認証情報やユーザー設定も読みません。"
                   Margin="0,6,0,16"
                   Foreground="Gray"
                   TextWrapping="Wrap" />
        <Border BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="接続状態" FontWeight="SemiBold" />
            <TextBlock x:Name="ConnectionStatusText"
                       Margin="0,5,0,0"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
        </Border>
        <TextBlock Text="1. 専用作業フォルダーを確認"
                   FontSize="16"
                   FontWeight="SemiBold" />
        <TextBlock Text="この空のフォルダーだけを自動取得用に使用します。CLAUDE.mdやソースファイルは置きません。"
                   Margin="0,4,0,6"
                   Foreground="Gray"
                   TextWrapping="Wrap" />
        <TextBox x:Name="SettingsFolderBox"
                  IsReadOnly="True" />
        <Button x:Name="OpenFolderButton"
                Content="専用フォルダーを開く"
                HorizontalAlignment="Left"
                Padding="12,6"
                Margin="0,8,0,0"
                Click="OpenSettingsFolder" />
        <TextBlock Text="2. 利用者自身でClaude Codeを起動して信頼"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,18,0,0" />
        <TextBlock x:Name="DesktopLimitationText"
                   Text="下のコマンドをPowerShellへ貼り付け、公式CLIの信頼確認で専用フォルダーを確認してから承認してください。監視アプリはこの選択を代行しません。承認後はEscで終了できます。"
                   Margin="0,6,0,0"
                   Foreground="Gray"
                   TextWrapping="Wrap" />
        <TextBox x:Name="ClaudeCommandBox"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 Margin="0,8,0,0" />
        <Button x:Name="CopyClaudeCommandButton"
                 Content="起動コマンドをコピー"
                HorizontalAlignment="Left"
                Padding="12,6"
                 Margin="0,8,0,0"
                 Click="CopyClaudeCommand" />
        <TextBlock Text="3. 接続テスト"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,18,0,0" />
        <TextBlock x:Name="PromptInstructionText"
                   Text="承認後に接続テストを実行してください。監視アプリは隠しCLIへ/usageだけを送り、現在の5時間枠・週間枠を専用pipeから受け取ります。model promptやtool callは発生させません。"
                   Margin="0,6,0,0"
                   Foreground="Gray"
                   TextWrapping="Wrap" />
        <Button x:Name="TestConnectionButton"
                Content="接続テストを実行"
                HorizontalAlignment="Left"
                Padding="12,6"
                Margin="0,10,0,0"
                Click="TestConnection" />
        <TextBlock x:Name="ActionMessageText"
                   Margin="0,8,0,0"
                   Foreground="#4488CC"
                   TextWrapping="Wrap" />
        <Border BorderBrush="#B8860B"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,18,0,0">
          <StackPanel>
            <TextBlock x:Name="NonRecommendedLabel"
                       Text="非推奨"
                       FontWeight="SemiBold"
                       Foreground="#B8860B" />
            <TextBlock Margin="0,5,0,0"
                       TextWrapping="Wrap">
              <Hyperlink x:Name="LlmSetupSupportLink"
                         Click="OpenLlmSetupReadme">LLMに任せてセットアップする際の案内はこちら</Hyperlink>
              <Run Text="。信頼確認はLLMに代行させず、必ず利用者自身で行ってください。" />
            </TextBlock>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
