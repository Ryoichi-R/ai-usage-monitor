<Window x:Class="AiUsageMonitor.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Usage Monitor 設定"
        Icon="Assets/ai-usage-monitor.ico"
        Width="720"
        Height="610"
        MinWidth="680"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False">
  <DockPanel Margin="16">
    <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="ValidationMessage"
                 Foreground="Crimson"
                 VerticalAlignment="Center"
                 TextWrapping="Wrap"
                 AutomationProperties.LiveSetting="Assertive" />
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Content="キャンセル"
                Width="88"
                Margin="8,0"
                IsCancel="True" />
        <Button x:Name="SaveButton"
                Content="保存"
                Width="88"
                IsDefault="True"
                Click="Save" />
      </StackPanel>
    </Grid>

    <TabControl x:Name="CategoryTabs" TabStripPlacement="Left" SelectedIndex="0">
      <TabControl.Resources>
        <Style TargetType="TabItem">
          <Setter Property="Width" Value="148" />
          <Setter Property="HorizontalContentAlignment" Value="Left" />
          <Setter Property="Padding" Value="12,9" />
        </Style>
        <Style TargetType="CheckBox">
          <Setter Property="Margin" Value="4,7" />
        </Style>
        <Style x:Key="FieldGrid" TargetType="Grid">
          <Setter Property="Margin" Value="4,3" />
        </Style>
      </TabControl.Resources>

      <TabItem Header="全体設定">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16">
            <TextBlock Text="全体設定"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12" />
            <CheckBox x:Name="ClickThroughBox" Content="クリックを透過する" />
            <CheckBox x:Name="TopmostBox" Content="常に手前に表示する" />
            <CheckBox x:Name="StartupBox" Content="Windowsログオン時に自動起動する" />
            <Grid Style="{StaticResource FieldGrid}" Margin="4,14,4,3">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="表示倍率（75～200%）" VerticalAlignment="Center" />
              <TextBox x:Name="ScaleBox"
                       Grid.Column="1"
                       AutomationProperties.Name="表示倍率" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="表示位置">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16">
            <TextBlock Text="表示位置"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12" />
            <StackPanel Orientation="Horizontal" Margin="4,0,4,10">
              <RadioButton x:Name="PresetPlacementBox"
                           Content="四隅・余白を使用"
                           Margin="0,0,18,0" />
              <RadioButton x:Name="CustomPlacementBox"
                           Content="自由配置（保存済み位置）" />
            </StackPanel>
            <Grid Style="{StaticResource FieldGrid}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="表示モニター" VerticalAlignment="Center" />
              <ComboBox x:Name="MonitorBox" Grid.Column="1" />
            </Grid>
            <Grid Style="{StaticResource FieldGrid}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="基準位置" VerticalAlignment="Center" />
              <ComboBox x:Name="AnchorBox" Grid.Column="1" />
            </Grid>
            <Grid Style="{StaticResource FieldGrid}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="水平余白（0～200 DIP）" VerticalAlignment="Center" />
              <TextBox x:Name="HorizontalMarginBox"
                       Grid.Column="1"
                       AutomationProperties.Name="水平余白" />
            </Grid>
            <Grid Style="{StaticResource FieldGrid}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="垂直余白（0～200 DIP）" VerticalAlignment="Center" />
              <TextBox x:Name="VerticalMarginBox"
                       Grid.Column="1"
                       AutomationProperties.Name="垂直余白" />
            </Grid>
            <WrapPanel Margin="4,12,4,4">
              <Button Content="現在位置を使用"
                      Padding="12,5"
                      Margin="0,0,8,0"
                      Click="SaveCurrentPosition" />
              <Button Content="既定の右上へ戻す"
                      Padding="12,5"
                      Click="ResetPosition" />
            </WrapPanel>
            <TextBlock x:Name="PlacementStatusText"
                       Margin="4,8"
                       Foreground="Gray"
                       TextWrapping="Wrap" />
            <TextBlock Text="クリック透過を解除すると、メイン表示をドラッグして移動できます。ドラッグ後の位置は自動保存されます。"
                       Margin="4,12"
                       Foreground="Gray"
                       TextWrapping="Wrap" />
            <TextBlock Text="表示倍率を変更すると、保存済みの位置は新しいウィジェットサイズに合わせて再計算されます。"
                       Margin="4,0,4,12"
                       Foreground="Gray"
                       TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="CODEX">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16">
            <TextBlock Text="CODEX"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12" />
            <CheckBox x:Name="ShowCodexBox" Content="Codex使用上限を表示する" />
            <CheckBox x:Name="ShowAdditionalUsageBox" Content="追加利用額を表示する" />
            <CheckBox x:Name="ShowCreditsBox" Content="クレジット残高を表示する" />
            <TextBlock Text="監視アカウント" Margin="4,14,4,4" FontWeight="SemiBold"/>
            <DataGrid x:Name="CodexAccountsGrid" Margin="4" MinHeight="150"
                      AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single">
              <DataGrid.Columns>
                <DataGridTextColumn Header="表示名" Binding="{Binding DisplayName}" Width="110"/>
                <DataGridTemplateColumn Header="CODEX_HOME（既定は空欄）" Width="*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBox Text="{Binding CodexHomePath, UpdateSourceTrigger=PropertyChanged}"
                               IsReadOnly="{Binding IsDefault}"
                               BorderThickness="0"
                               Padding="2"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridCheckBoxColumn Header="監視" Binding="{Binding Enabled}" Width="55"/>
                <DataGridCheckBoxColumn Header="表示" Binding="{Binding ShowInWidget}" Width="55"/>
              </DataGrid.Columns>
            </DataGrid>
            <StackPanel Orientation="Horizontal" Margin="4,0,4,6">
              <Button Content="追加" Padding="12,4" Margin="0,0,8,0" Click="AddCodexAccount"/>
              <Button Content="フォルダー選択…" Padding="12,4" Margin="0,0,8,0" Click="SelectCodexHome"/>
              <Button Content="選択した設定を削除" Padding="12,4" Click="RemoveCodexAccount"/>
            </StackPanel>
            <TextBlock Text="設定を削除してもCODEX_HOMEの実フォルダーは削除しません。"
                       Margin="4,0,4,8" Foreground="Gray" TextWrapping="Wrap"/>
            <TextBlock Text="Codex実行ファイル（空欄は自動検出）"
                       Margin="4,12,4,0" />
            <TextBox x:Name="ExecutableBox" Margin="4" />
            <Grid Style="{StaticResource FieldGrid}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="更新間隔（60～900秒）" VerticalAlignment="Center" />
              <TextBox x:Name="RefreshBox"
                       Grid.Column="1"
                       AutomationProperties.Name="更新間隔" />
            </Grid>
            <Grid Style="{StaticResource FieldGrid}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="起動待ち（5～120秒）" VerticalAlignment="Center" />
              <TextBox x:Name="StartupTimeoutBox"
                       Grid.Column="1"
                       AutomationProperties.Name="起動待ち" />
            </Grid>
            <TextBlock Text="バーと数値は使用済みではなく残り割合を示します。"
                       Margin="4,12"
                       Foreground="Gray"
                       TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="CLAUDE CODE">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16">
            <TextBlock Text="CLAUDE CODE"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12" />
             <CheckBox x:Name="ShowClaudeBox" Content="Claude Code使用上限を表示する" />
            <TextBlock Text="取得方法" Margin="4,12,4,2" />
            <ComboBox x:Name="ClaudeModeBox"
                      Margin="4"
                      AutomationProperties.Name="Claude取得方法" />
            <TextBlock Text="Claude実行ファイル（空欄は公式install経路から自動検出）"
                       Margin="4,8,4,2" />
            <TextBox x:Name="ClaudeExecutableBox"
                     Margin="4"
                     AutomationProperties.Name="Claude実行ファイル" />
            <Border BorderBrush="#3A3A3A"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="10"
                    Margin="4,6,4,10">
              <StackPanel>
                <TextBlock Text="接続状態" FontWeight="SemiBold" />
                <TextBlock x:Name="ClaudeConnectionStatusText"
                           Margin="0,4,0,8"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
                <Button x:Name="ClaudeSetupButton"
                        Content="Claude Code連携を設定する"
                        HorizontalAlignment="Left"
                        Padding="12,5"
                        Click="OpenClaudeSetup" />
              </StackPanel>
            </Border>
            <TextBlock Text="自動取得は署名済みの公式Claude CLIを隠しセッションで起動し、/usageだけを送ります。認証情報やユーザー設定は読みません。初回のみ専用フォルダーの信頼承認が必要です。"
                       Margin="4,4,4,12"
                       Foreground="Gray"
                       TextWrapping="Wrap" />
            <TextBlock Text="HUDのCLIは/usage画面の読取り完了時刻、SL受信はstatusLineのpipe受信時刻です。どちらもserver measurement timestampではありません。"
                       Margin="4,0,4,12"
                       Foreground="Gray"
                       TextWrapping="Wrap" />
            <Expander Header="常駐CLIのstatusLineも利用する場合の設定例"
                      Margin="4,4,4,0">
              <StackPanel>
                <TextBox x:Name="ClaudeExampleBox"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         MinHeight="96"
                         MaxHeight="180"
                         Margin="0,6,0,4" />
                <Button Content="Claude Code設定をコピー"
                        Click="CopyClaudeExample"
                        HorizontalAlignment="Left"
                        Padding="12,5" />
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
